# ─── LiveKit ───────────────────────────────────────────
# Get from: https://livekit.io → Cloud → Your Project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── AI Provider ───────────────────────────────────────
# Options: "google" | "openai"
# Recommended: "google" — free tier at https://aistudio.google.com/
AI_PROVIDER=google

# Google Gemini (recommended — free tier available)
GOOGLE_API_KEY=your-google-ai-studio-key

# OpenAI (alternative — requires billing)
# OPENAI_API_KEY=your-openai-api-key

# ─── Supabase (for saving interview metadata) ──────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Agent Config ──────────────────────────────────────
AGENT_LOG_LEVEL=INFO
MAX_INTERVIEW_DURATION_SECONDS=3600
