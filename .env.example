# ─── App & College Configuration ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
COLLEGE_OFFICIAL_DOMAIN=kce.ac.in
COLLEGE_NAME="Karpagam College of Engineering"

# ─── Security & Session Secrets ──────────────────────────────────
# Server-side HMAC secret for signing session cookies & OTP hashes
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-32-byte-hex-secret-here

# ─── Outbound Email Provider (Verification & Personalized Welcome) ──
# Option 1: Resend API (Recommended for production delivery to @kce.ac.in)
RESEND_API_KEY=re_your_api_key_here

# Option 2: SMTP Relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=placements@kce.ac.in
SMTP_PASS=your-secure-app-password

# Email Sender Profile
EMAIL_FROM_NAME="SkillMatch AI (KCE Placement Office)"
EMAIL_FROM_ADDRESS=placements@kce.ac.in

# ─── Supabase (Production Database & Auth Provider) ──────────────
# Found in: https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-only, never expose to client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LiveKit (Face-to-Face AI Interview Audio & Video) ───────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── AI Provider (Gemini / Claude / OpenAI) ───────────────────────
AI_PROVIDER=google
AI_API_KEY=your-google-ai-studio-key
AI_MODEL=gemini-2.0-flash

# ─── Job APIs & External Integrations ────────────────────────────
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
GITHUB_TOKEN=your-github-token

# ─── Initial Admin Bootstrap Credentials ─────────────────────────
# Initial bootstrap credentials seeded securely for demonstration:
# Super Admin: superadmin@kce.ac.in / SuperAdmin@KCE2026! (MFA Code sent to email or 6-digit code in dev log)
# College Admin: placement.admin@kce.ac.in / PlacementAdmin@KCE2026! (MFA Code sent to email or 6-digit code in dev log)
